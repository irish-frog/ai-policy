{
  "manifest_version": 3,
  "name": "AI Usage Warning",
  "version": "1.0.0",
  "description": "Displays a company warning banner on approved AI websites.",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*"
      ],
      "js": ["banner.js"],
      "run_at": "document_idle"
    }
  ]
}
